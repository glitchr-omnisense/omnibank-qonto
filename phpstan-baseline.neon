parameters:
	ignoreErrors:
		-
			message: '#^Cannot access offset ''bank_accounts'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: Accounts.php

		-
			message: '#^Cannot cast mixed to int\.$#'
			identifier: cast.int
			count: 2
			path: Accounts.php

		-
			message: '#^Cannot cast mixed to string\.$#'
			identifier: cast.string
			count: 7
			path: Accounts.php

		-
			message: '#^Method Omnibank\\Qonto\\Accounts\:\:account\(\) has parameter \$data with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: Accounts.php

		-
			message: '#^Method Omnibank\\Qonto\\Accounts\:\:balances\(\) has parameter \$data with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: Accounts.php

		-
			message: '#^Method Omnibank\\Qonto\\Accounts\:\:fetch\(\) should return list\<array\<string, mixed\>\> but returns list\<array\<mixed, mixed\>\>\.$#'
